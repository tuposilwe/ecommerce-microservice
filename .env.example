JWT_SECRET =
STRIPE_SECRET_KEY =
STRIPE_WEBHOOK_SECRET_KEY=

# Used by docker-compose.yml for the Postgres container and the app's datasource
POSTGRES_PASSWORD=postgres
POSTGRES_DB=store_api

# Public origin the container is reached at (used for Stripe checkout redirects).
# Defaults to http://localhost:8080 if unset.
WEBSITE_URL=http://localhost:8080