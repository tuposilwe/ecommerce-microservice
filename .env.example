JWT_SECRET =
STRIPE_SECRET_KEY =
STRIPE_WEBHOOK_SECRET_KEY=

# Shared root password for the four per-service Postgres containers
# (user-db, catalog-db, cart-db, order-db). Each still has its own
# database/volume — this is just a demo-friendly shared credential.
POSTGRES_PASSWORD=postgres

# Public origin the api-gateway container is reached at (used for Stripe
# checkout redirects). Defaults to http://localhost:8080 if unset.
WEBSITE_URL=http://localhost:8080
