                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "order-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "payment-service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
