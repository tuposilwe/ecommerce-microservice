<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="System Design" id="system-design">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1190" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="ecommerce-microservice — System Design" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="0" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="50" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="gateway" value="api-gateway  :8080&#10;Spring Cloud Gateway (WebFlux)&#10;also hosts the bundled React SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="440" y="160" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- Business services row -->
        <mxCell id="user-svc" value="user-service  :8081&#10;auth (JWT) + user CRUD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="catalog-svc" value="catalog-service  :8082&#10;products, categories, images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cart-svc" value="cart-service  :8083&#10;guest carts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="490" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="order-svc" value="order-service  :8084&#10;orders + checkout initiation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="payment-svc" value="payment-service  :8085&#10;Stripe checkout + webhook&#10;(stateless, no DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="950" y="300" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Databases / external -->
        <mxCell id="user-db" value="user-db&#10;:5433" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="catalog-db" value="catalog-db&#10;:5434" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cart-db" value="cart-db&#10;:5435" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="460" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="order-db" value="order-db&#10;:5436" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="460" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stripe" value="Stripe&#10;(external)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="990" y="455" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="Kafka  :9092&#10;topic: payment-events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="790" y="600" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Cross-cutting infra -->
        <mxCell id="infra-label" value="Cross-cutting infrastructure — every service above registers with Eureka, fetches its config from Config Server, and reports traces to Zipkin" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="710" width="1120" height="24" as="geometry" />
        </mxCell>
        <mxCell id="eureka" value="eureka-server&#10;:8761&#10;service registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="120" y="750" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="config" value="config-server&#10;:8888&#10;serves config-repo/*.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="390" y="750" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="zipkin" value="zipkin&#10;:9411&#10;distributed tracing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="660" y="750" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Edges: client -> gateway -->
        <mxCell id="e-client-gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="client" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: gateway -> services -->
        <mxCell id="e-gw-user" value="/api/users, /api/auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="gateway" target="user-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-catalog" value="/api/products, /api/categories" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="gateway" target="catalog-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-cart" value="/api/carts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="gateway" target="cart-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-order" value="/api/orders, /api/checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="gateway" target="order-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-payment" value="/api/checkout/webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="gateway" target="payment-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: Feign calls between services (same row, left-right) -->
        <mxCell id="e-cart-catalog" value="Feign: GET /products/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="cart-svc" target="catalog-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-order-cart" value="Feign: get / clear cart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="order-svc" target="cart-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-order-payment" value="Feign: create checkout session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="order-svc" target="payment-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: services -> their DBs -->
        <mxCell id="e-user-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;" edge="1" parent="1" source="user-svc" target="user-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-catalog-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;" edge="1" parent="1" source="catalog-svc" target="catalog-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cart-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;" edge="1" parent="1" source="cart-svc" target="cart-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-order-db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;" edge="1" parent="1" source="order-svc" target="order-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: payment -> stripe -->
        <mxCell id="e-payment-stripe" value="Stripe API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#d6b656;" edge="1" parent="1" source="payment-svc" target="stripe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: Kafka -->
        <mxCell id="e-payment-kafka" value="publish PaymentEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#d79b00;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="payment-svc" target="kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-kafka-order" value="consume, update order status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#d79b00;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kafka" target="order-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dashed edges: gateway -> cross-cutting infra (representative; applies to all services) -->
        <mxCell id="e-gw-eureka" value="register / discover" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="eureka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-config" value="fetch config" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-gw-zipkin" value="traces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="zipkin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
